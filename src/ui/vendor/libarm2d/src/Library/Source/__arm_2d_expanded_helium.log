    ptOffs = tPointHi.X + tPointHi.Y * iOrigStride;
    ptVal = vldrwq_gather_shifted_offset_z_u32(pOrigin, ptOffs, predTailHigh & p);
    vst1q(scratch32 + 4, ptVal);
    maskVal = ptVal >> 24;
