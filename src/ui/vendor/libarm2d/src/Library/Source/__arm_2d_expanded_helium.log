    uint32x4_t ptOffs = tPointLo.X + tPointLo.Y * iOrigStride;
    uint32x4_t ptVal = vldrwq_gather_shifted_offset_z_u32(pOrigin, ptOffs, predTailLow & p);
    vst1q(scratch32, ptVal);
    uint32x4_t maskVal = ptVal >> 24;
