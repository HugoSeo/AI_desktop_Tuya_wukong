# 48 "E:/Work/Arm-2D/Library/Source\\__arm_2d_ll_fill_colour_helium.inc"
void __arm_2d_impl_c8bit_colour_filling(uint8_t *__restrict pTarget,
                                        int16_t iTargetStride,
                                        arm_2d_size_t *__restrict ptCopySize,
                                        uint8_t Colour)
{
  uint8x16_t vColor = vdupq_n_u8(Colour);
# 73 "E:/Work/Arm-2D/Library/Source\\__arm_2d_ll_fill_colour_helium.inc"
  for (int_fast16_t y = 0; y < ptCopySize->iHeight; y++)
  {
    int32_t blkCnt = ptCopySize->iWidth;
    uint8_t *pTargetCur = pTarget;

    __asm volatile(
        ".p2align 2                                              	\n"
        "   wlstp."
        "8"
        " lr, %[loopCnt], 1f    \n"
        "2:                                                      	\n"
        "   vstrb.8                %q[vColor], [%[pTarget]], #16 	\n"
        "   letp                    lr, 2b                       	\n"
        "1:                                                      	\n"

        : [pTarget] "+r"(pTargetCur)
        : [loopCnt] "r"(blkCnt), [vColor] "t"(vColor)
        : "memory", "lr");

    pTarget += iTargetStride;
  }
}
