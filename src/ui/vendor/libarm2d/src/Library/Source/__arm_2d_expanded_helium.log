  vAvgR = (vAvgPixelR);
  vAvgG = (vAvgPixelG);
  vAvgB = (vAvgPixelB);
  vAvgTrans = (vAvgTransparency);

  uint16x8_t vTargetR, vTargetG, vTargetB;
