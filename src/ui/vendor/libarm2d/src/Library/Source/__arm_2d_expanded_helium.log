__attribute__((always_inline)) static inline uint16x8_t __arm_2d_blend_gray8(uint16x8_t vtrgt, uint16_t chColour, uint16x8_t opa)
{
  uint16x8_t vTrans = 256 - opa;

  return (vmulq(vTrans, chColour) + vmulq(vtrgt, opa)) >> 8;
}

__attribute__((always_inline)) static inline uint16x8_t __arm_2d_blend_n_gray8(uint16x8_t vtrgt, uint16_t chColour, uint16_t opa)
{
