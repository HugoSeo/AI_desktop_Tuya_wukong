# AI Mode Scode Configuration
# Sourced from: src/mode/

menu "AI Mode Configuration"
    menu "Enabled AI Mode"
        config ENABLE_AI_MODE_HOLD
            bool "Chat-Hold (press and talk)"
            default n

        config ENABLE_AI_MODE_ONESHOT
            bool "Chat-Oneshot (press once)"
            default n

        config ENABLE_AI_MODE_WAKEUP
            bool "Chat-Wakeup word"
            default n

        config ENABLE_AI_MODE_FREE
            bool "Chat-Free conversation"
            default n

        config ENABLE_AI_MODE_TRANSLATE
            bool "Translation"
            default n

        config ENABLE_AI_MODE_P2P
            bool "P2P audio/video call"
            default n

        config ENABLE_AI_MODE_RECORD
            bool "Recording and transcribe"
            default n

        config ENABLE_AI_MODE_PICTURE
            bool "Picture generation"
            default n

        config ENABLE_AI_MODE_DETECTION
            bool "Motion detect"
            depends on ENABLE_TUYA_CAMERA
            default n

    endmenu

    # --- AI Chat Default Mode ---
    choice
        prompt "Default AI Mode"
        default AI_CHAT_DEFAULT_HOLD

        config AI_CHAT_DEFAULT_HOLD
            bool "Chat-Hold (press and talk)"
            depends on ENABLE_AI_MODE_HOLD

        config AI_CHAT_DEFAULT_ONESHOT
            bool "Chat-Oneshot (press once)"
            depends on ENABLE_AI_MODE_ONESHOT

        config AI_CHAT_DEFAULT_WAKEUP
            bool "Chat-Wakeup word"
            depends on ENABLE_AI_MODE_WAKEUP

        config AI_CHAT_DEFAULT_FREE
            bool "Chat-Free conversation"
            depends on ENABLE_AI_MODE_FREE

        config AI_CHAT_DEFAULT_TRANSLATE
            bool "Translation"
            depends on ENABLE_AI_MODE_TRANSLATE

        config AI_CHAT_DEFAULT_P2P
            bool "P2P audio/vido call"
            depends on ENABLE_AI_MODE_P2P

        config AI_CHAT_DEFAULT_RECORD
            bool "Recording and transcribe"
            depends on ENABLE_AI_MODE_RECORD

        config AI_CHAT_DEFAULT_PICTURE
            bool "Picture generation"
            depends on ENABLE_AI_MODE_PICTURE

        config AI_CHAT_DEFAULT_DETECTION
            bool "Motion detect"
            depends on ENABLE_AI_MODE_DETECTION
    endchoice

    config TUYA_AI_CHAT_DEFAULT_MODE
        int
        default 0 if AI_CHAT_DEFAULT_HOLD
        default 1 if AI_CHAT_DEFAULT_ONESHOT
        default 2 if AI_CHAT_DEFAULT_WAKEUP
        default 3 if AI_CHAT_DEFAULT_FREE
        default 4 if AI_CHAT_DEFAULT_TRANSLATE
        default 5 if AI_CHAT_DEFAULT_P2P
        default 6 if AI_CHAT_DEFAULT_RECORD
        default 7 if AI_CHAT_DEFAULT_PICTURE
        default 8 if AI_CHAT_DEFAULT_DETECTION


    menu "AI Agent Solution Code"

        choice
            prompt "AI Agent Scode preset"
            default AI_AGENT_SCODE_PRESET_DEFAULT
            help
                选择 AI Agent solution code 预设方案：
                default   - 通用场景，仅 translate 使用 asr-llm-tts，其余留空
                multimode - 桌面机器人多模态预设（MULTIMODAL_CHAT/REALTIME_TRANSLATION/
                            VOICE_TO_IMAGE/MOTION_DETECTION）
                custom    - 在下方四个条目里手动填写（初值与 default 预设一致）

            config AI_AGENT_SCODE_PRESET_DEFAULT
                bool "default"
                help
                    通用场景预设：translate=asr-llm-tts，其余留空

            config AI_AGENT_SCODE_PRESET_MULTIMODE
                bool "multimode"
                help
                    桌面机器人多模态预设，对应 T5AI_BOARD_DESKTOP

            config AI_AGENT_SCODE_PRESET_CUSTOM
                bool "custom"
                help
                    自定义：初值与 default 预设一致，用户可在下方四个条目里改
        endchoice

        # ------------------------------------------------------------------
        # User-editable overrides, only visible/active under CUSTOM preset.
        # 初始默认值跟 DEFAULT 预设一致；用户改过之后会保留到 .config，
        # 切到其它预设时这几行被隐藏但保存值不丢，下次切回 CUSTOM 还在。
        # ------------------------------------------------------------------
        config AI_AGENT_SCODE_CHAT_USER
            string "Chat mode scode"
            depends on AI_AGENT_SCODE_PRESET_CUSTOM
            default ""
            help
                聊天模式的 solution code，默认与 default 预设一致

        config AI_AGENT_SCODE_TRANSLATE_USER
            string "Translate mode scode"
            depends on AI_AGENT_SCODE_PRESET_CUSTOM
            default "asr-llm-tts"
            help
                翻译模式的 solution code，默认与 default 预设一致

        config AI_AGENT_SCODE_PICTURE_USER
            string "Picture mode scode"
            depends on AI_AGENT_SCODE_PRESET_CUSTOM
            default ""
            help
                生图模式的 solution code，默认与 default 预设一致

        config AI_AGENT_SCODE_DETECTION_USER
            string "Detection mode scode"
            depends on AI_AGENT_SCODE_PRESET_CUSTOM
            default ""
            help
                侦测模式的 solution code，默认与 default 预设一致

        # ------------------------------------------------------------------
        # Final scode symbols consumed by C code. No prompt — purely derived.
        # CUSTOM 预设下转引上面的 *_USER；其它预设按硬编码默认值。
        # ------------------------------------------------------------------
        config AI_AGENT_SCODE_CHAT
            string
            default AI_AGENT_SCODE_CHAT_USER if AI_AGENT_SCODE_PRESET_CUSTOM
            default "MULTIMODAL_CHAT" if AI_AGENT_SCODE_PRESET_MULTIMODE
            default ""

        config AI_AGENT_SCODE_TRANSLATE
            string
            default AI_AGENT_SCODE_TRANSLATE_USER if AI_AGENT_SCODE_PRESET_CUSTOM
            default "REALTIME_TRANSLATION" if AI_AGENT_SCODE_PRESET_MULTIMODE
            default "asr-llm-tts" if AI_AGENT_SCODE_PRESET_DEFAULT
            default ""

        config AI_AGENT_SCODE_PICTURE
            string
            default AI_AGENT_SCODE_PICTURE_USER if AI_AGENT_SCODE_PRESET_CUSTOM
            default "VOICE_TO_IMAGE" if AI_AGENT_SCODE_PRESET_MULTIMODE
            default ""

        config AI_AGENT_SCODE_DETECTION
            string
            default AI_AGENT_SCODE_DETECTION_USER if AI_AGENT_SCODE_PRESET_CUSTOM
            default "MOTION_DETECTION" if AI_AGENT_SCODE_PRESET_MULTIMODE
            default ""

        # ------------------------------------------------------------------
        # DEFAULT / MULTIMODE 下用 comment 展示当前生效的 4 个 scode 值
        # （CUSTOM 模式不需要 —— 上面的 *_USER prompt 已经把值露出来了）
        # ------------------------------------------------------------------
        if AI_AGENT_SCODE_PRESET_DEFAULT
            comment "Chat mode scode:        \"\""
            comment "Translate mode scode:   \"asr-llm-tts\""
            comment "Picture mode scode:     \"\""
            comment "Detection mode scode:   \"\""
        endif

        if AI_AGENT_SCODE_PRESET_MULTIMODE
            comment "Chat mode scode:        \"MULTIMODAL_CHAT\""
            comment "Translate mode scode:   \"REALTIME_TRANSLATION\""
            comment "Picture mode scode:     \"VOICE_TO_IMAGE\""
            comment "Detection mode scode:   \"MOTION_DETECTION\""
        endif
    endmenu

endmenu
