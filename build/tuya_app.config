CONFIG_TUYA_MODULE_T5=y
CONFIG_ENABLE_AI_MODE_ONESHOT=y
CONFIG_ENABLE_AI_MODE_WAKEUP=y
CONFIG_ENABLE_AI_MODE_FREE=y
CONFIG_ENABLE_DEFAULT_SESSION=y
# CONFIG_T5AI_BOARD is not set
CONFIG_T5AI_BOARD_EYES=y
# CONFIG_T5AI_BOARD_EVB is not set
# CONFIG_T5AI_BOARD_EVB_PRO is not set
# CONFIG_T5AI_BOARD_ROBOT is not set
# CONFIG_T5AI_BOARD_DESKTOP is not set
# CONFIG_T2AI_BOARD is not set
# CONFIG_LE270AI_BOARD is not set
# CONFIG_L511_Y6E_BOARD is not set
# CONFIG_L511_Y7PM_BOARD is not set
# CONFIG_T1AI_BOARD is not set
# CONFIG_T3AI_BOARD is not set
# CONFIG_T3_V_PRO_BOARD is not set
# CONFIG_RTL8720CF_VU2_BOARD is not set
# CONFIG_WUKONG_BOARD_UBUNTU is not set

#
# Pin Configuration
#
CONFIG_TUYA_AI_TOY_AUDIO_TRIGGER_PIN_NUM=9
CONFIG_TUYA_AI_TOY_SPK_EN_PIN_NUM=48
CONFIG_TUYA_AI_TOY_LED_PIN_NUM=64
CONFIG_TUYA_AI_TOY_NET_PIN_NUM=64
# CONFIG_DEVICE_POWER_CONTROL is not set
# end of Pin Configuration

#
# Display Configuration
#
CONFIG_TUYA_LCD_IC_NAME_STR="spi_st7735s"
CONFIG_TUYA_LCD_WIDTH_VAL=128
CONFIG_TUYA_LCD_HEIGHT_VAL=128
CONFIG_LCD_FPS_VAL=10
CONFIG_TUYA_LCD_ROTATION_VAL=0
CONFIG_LCD_SPI_DEVICE_NUM=1
# end of Display Configuration

#
# AI Agent Scode Configuration
#
CONFIG_AI_AGENT_SCODE_PRESET_DEFAULT=y
# CONFIG_AI_AGENT_SCODE_PRESET_MULTIMODE is not set
# CONFIG_AI_AGENT_SCODE_PRESET_CUSTOM is not set
CONFIG_AI_AGENT_SCODE_CHAT=""
CONFIG_AI_AGENT_SCODE_TRANSLATE="asr-llm-tts"
CONFIG_AI_AGENT_SCODE_PICTURE=""
CONFIG_AI_AGENT_SCODE_DETECTION=""

#
# Chat mode scode:        ""
#

#
# Translate mode scode:   "asr-llm-tts"
#

#
# Picture mode scode:     ""
#

#
# Detection mode scode:   ""
#
# end of AI Agent Scode Configuration

# CONFIG_ENABLE_BATTERY is not set
# CONFIG_ENABLE_TUYA_CAMERA is not set
CONFIG_ENABLE_TUYA_TOOLKITS=y
CONFIG_ENABLE_TOOLKITS_TM=y
CONFIG_ENABLE_TOOLKITS_CONTROL=y
# CONFIG_ENABLE_TOOLKITS_PLAYBACK is not set
# CONFIG_ENABLE_TOOLKITS_IMM is not set
# CONFIG_ENABLE_TOOLKITS_SOCIAL is not set
# CONFIG_ENABLE_TUYA_UI is not set

#
# Audio Configuration
#

#
# Audio Input
#

#
# --- Source ---
#
# CONFIG_USING_UART_AUDIO_INPUT is not set
CONFIG_USING_BOARD_AUDIO_INPUT=y
CONFIG_INPUT_BOARD_STACK_SIZE=2560

#
# --- Frontend ---
#
CONFIG_USING_TUYA_AUDIO_FRONTEND=y
# CONFIG_USING_3RD_AUDIO_FRONTEND is not set

#
# --- Encoder ---
#
CONFIG_ENABLE_APP_OPUS_ENCODER=y
# CONFIG_ENABLE_APP_SPEEX_ENCODER is not set
CONFIG_APP_OPUS_ENCODER_BITRATE=16000
CONFIG_APP_OPUS_ENCODER_BANDWIDTH=1102
# end of Audio Input

#
# Audio Output
#

#
# --- Target ---
#
# CONFIG_USING_UART_AUDIO_OUTPUT is not set
CONFIG_USING_BOARD_AUDIO_OUTPUT=y

#
# --- Decoder / Player ---
#
# CONFIG_AI_PLAYER_LITE is not set
CONFIG_AI_PLAYER_DECODER_OPUS_ENABLE=y
CONFIG_AI_PLAYER_DECODER_OPUS_FRAME_SIZE=40
CONFIG_AI_PLAYER_DECODER_OPUS_KBPS=16
CONFIG_AI_PLAYER_DECODER_OGGOPUS_ENABLE=y
# end of Audio Output

# CONFIG_CODEC_BENCH_TEST is not set
# end of Audio Configuration

# CONFIG_ENABLE_CELLULAR_DONGLE is not set
# CONFIG_AI_CHAT_DEFAULT_ONESHOT is not set
# CONFIG_AI_CHAT_DEFAULT_WAKEUP is not set
CONFIG_AI_CHAT_DEFAULT_FREE=y
CONFIG_TUYA_AI_CHAT_DEFAULT_MODE=3

#
# Device Defaults
#
CONFIG_TY_SPK_DEFAULT_VOL=90
CONFIG_TY_AI_DEFAULT_LANG=1
# CONFIG_ENABLE_AUDIO_ANALYSIS is not set
# CONFIG_ENABLE_APP_AI_MONITOR is not set
# CONFIG_ENABLE_CLOUD_ALERT is not set
# CONFIG_ENABLE_APP_JOYINSIDE is not set
CONFIG_ENABLE_AI_MF_TEST=y
# CONFIG_ENABLE_LOW_POWER is not set
# end of Device Defaults
